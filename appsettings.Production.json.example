{
  "//": "生产配置模板。用法：在服务器上复制为 appsettings.Production.json 并填入真实值。",
  "//2": "该文件（以及任何填好的 Production 配置）已被 .gitignore 忽略，绝不进版本库。",
  "//3": "应用私钥推荐用环境变量 ALIPAY_PRIVATE_KEY 注入，而不是写在文件里；变量会覆盖此文件同名配置。",
  "//4": "应用私钥必须是 PKCS#1 纯 Base64（无 PEM 头尾）。若填 PKCS#8，服务会在启动时直接报错终止。",

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },

  "Alipay": {
    "Aipay": {
      "ServerUrl": "https://openapi.alipay.com/gateway.do",
      "AppId": "<你的 AppId，16 位数字，例如 2021xxxxxxxxxxxx>",
      "PrivateKey": "<应用私钥 PKCS#1 纯 Base64；推荐改用环境变量 ALIPAY_PRIVATE_KEY 注入>",
      "AlipayPublicKey": "<平台导出的支付宝公钥>",
      "SellerId": "<2088 开头的商户 PID/SellerId>",
      "SellerName": "<支付账单上显示的商户名称>",
      "ServiceId": "<服务市场创建服务后返回的真实 serviceId>",
      "Currency": "CNY",
      "SignType": "RSA2",
      "PayWindowMinutes": 30
    }
  },

  "//5": "SkillCatalog：资源目录。ResourceIdPrefix 是「订单身份」的一部分 —— 资源标识 = <前缀>:<资源编码>，建单时写进订单。",
  "//6": "重取产物时会拿订单里存的前缀与当前配置比对；前缀不一致，所有已付订单都会取不到货（404 RESOURCE_MISMATCH）。",
  "//7": "本服务历史订单绑定的是 paysvc —— 与历史订单绑定，不要改成别的值。Skills 段按现场实际资源填，见 README §5.2。",
  "SkillCatalog": {
    "ResourceIdPrefix": "paysvc"
  }
}
