{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "DatabasePath": "appdata/skillpay.db"
  },
  "Alipay": {
    "Aipay": {
      "ServerUrl": "https://openapi-sandbox.dl.alipaydev.com/gateway.do",
      "AppId": "",
      "PrivateKey": "",
      "AlipayPublicKey": "",
      "SellerId": "",
      "SellerName": "",
      "ServiceId": "api_mock_service_id",
      "Currency": "CNY",
      "SignType": "RSA2",
      "SellerUniqueIdKey": "seller_id",
      "PayWindowMinutes": 30
    }
  },
  "SkillCatalog": {
    "ResourceIdPrefix": "skillpay",
    "Skills": {
      "demo-skill": {
        "Price": "1.00",
        "GoodsName": "AI 技能调用（示例）",
        "Description": "用于联调的示例技能，替换为真实技能编码与单价。"
      },
      "skill-generate": {
        "Price": "1.00",
        "GoodsName": "AI 技能生成（单个技能）",
        "Description": "按 12 段规格生成 1 个可上架的技能包内容。一次调用计费一次。"
      }
    }
  },
  "Generation": {
    "Mode": "template",
    "Llm": {
      "BaseUrl": "",
      "ApiKey": "",
      "Model": "deepseek-chat",
      "TimeoutSeconds": 180,
      "Temperature": 0.3,
      "MaxTokens": 8192
    }
  }
}
