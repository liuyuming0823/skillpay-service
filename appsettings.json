{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "DatabasePath": "appdata/skillpay.db"
  },
  "Delivery": {
    "FulfillmentTimeoutSeconds": 600,
    "PayloadRoot": "payloads",
    "MaxInlinePayloadBytes": 8388608
  },
  "Alipay": {
    "Aipay": {
      "ServerUrl": "https://openapi-sandbox.dl.alipaydev.com/gateway.do",
      "AppId": "",
      "PrivateKey": "",
      "AlipayPublicKey": "",
      "SellerId": "",
      "SellerName": "",
      "ServiceId": "api_mock_service_id",
      "Currency": "CNY",
      "SignType": "RSA2",
      "SellerUniqueIdKey": "seller_id",
      "PayWindowMinutes": 30
    }
  },
  "SkillCatalog": {
    "ResourceIdPrefix": "skillpay",
    "Skills": {
      "demo-skill": {
        "Price": "1.00",
        "GoodsName": "示例付费资源",
        "Description": "文本交付示例。付款成功后会返回一段文本，用于验证「付款 → 交付」链路。",
        "PayloadText": "这是 demo-skill 的付费交付内容。\n\n看到这段文字，说明整条链路已经打通：\n  1. 客户端请求 → 服务端下发 402 账单\n  2. 客户端完成付款 → 携带 Payment-Proof 回访\n  3. 服务端向支付宝验付 → 校验本地订单\n  4. 生成交付物并落库 → 返回 200 与内容\n\n把它替换成你自己的交付物即可开始收费。\n"
      },
      "demo-file": {
        "Price": "1.00",
        "GoodsName": "示例文件交付",
        "Description": "文件交付示例。把 payloads/ 下的文件作为交付物，返回 Base64 与 SHA-256。",
        "PayloadFile": "example.txt",
        "PayloadFileName": "example.txt",
        "PayloadMimeType": "text/plain; charset=utf-8"
      }
    }
  }
}
